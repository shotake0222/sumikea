'use client';
import { useState, useEffect } from 'react';
import { supabase } from '../../../lib/supabase';
import AdminLayout from '../../../components/AdminLayout';

export default function AdminStoreManager() {
  const [stores, setStores] = useState<any[]>([]);
  const [allProperties, setAllProperties] = useState<any[]>([]);
  const [newStoreName, setNewStoreName] = useState('');
  const [newOwnerId, setNewOwnerId] = useState('');
  // 【追加】店舗の座標
  const [newLat, setNewLat] = useState('');
  const [newLng, setNewLng] = useState('');
  const [loading, setLoading] = useState(false);

  useEffect(() => { fetchData(); }, []);

  const fetchData = async () => {
    const { data: storesData } = await supabase.from('stores').select('*, store_property_permissions(property_id)');
    const { data: propsData } = await supabase.from('properties').select('*');
    if (storesData) setStores(storesData);
    if (propsData) setAllProperties(propsData);
  };

  const handleCreateStore = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoading(true);
    const { error } = await supabase.from('stores').insert([
      { name: newStoreName, owner_id: newOwnerId, lat: parseFloat(newLat), lng: parseFloat(newLng) }
    ]);
    if (!error) {
      await supabase.from('profiles').update({ role: 'SHOP' }).eq('id', newOwnerId);
      setNewStoreName(''); setNewOwnerId(''); setNewLat(''); setNewLng('');
      fetchData();
    }
    setLoading(false);
  };

  // 距離判定ヘルパー（約1km ≒ 0.01度）
  const isWithinRange = (s: any, p: any) => {
    if (!s.lat || !s.lng || !p.lat || !p.lng) return true; // データがない場合は一旦許可
    const dist = Math.sqrt(Math.pow(s.lat - p.lat, 2) + Math.pow(s.lng - p.lng, 2));
    return dist <= 0.01; 
  };

  const togglePermission = async (storeId: string, propertyId: string, isGranted: boolean) => {
    if (isGranted) {
      await supabase.from('store_property_permissions').delete().eq('store_id', storeId).eq('property_id', propertyId);
    } else {
      await supabase.from('store_property_permissions').insert([{ store_id: storeId, property_id: propertyId }]);
    }
    fetchData();
  };

  return (
    <AdminLayout userType="ADMIN">
      <div className="space-y-8">
        <section className="bg-white rounded-[2rem] p-8 shadow-sm border border-slate-100">
          <h2 className="text-xl font-black mb-6">🏪 新規店舗の登録（位置情報付き）</h2>
          <form onSubmit={handleCreateStore} className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <input className="bg-slate-50 p-4 rounded-2xl text-sm" placeholder="店舗名" value={newStoreName} onChange={e => setNewStoreName(e.target.value)} required />
            <input className="bg-slate-50 p-4 rounded-2xl text-sm font-mono" placeholder="Owner UID" value={newOwnerId} onChange={e => setNewOwnerId(e.target.value)} required />
            <input className="bg-slate-50 p-4 rounded-2xl text-sm" placeholder="緯度 (Lat) 例: 35.698" value={newLat} onChange={e => setNewLat(e.target.value)} required />
            <input className="bg-slate-50 p-4 rounded-2xl text-sm" placeholder="経度 (Lng) 例: 139.413" value={newLng} onChange={e => setNewLng(e.target.value)} required />
            <button className="md:col-span-2 bg-blue-600 text-white py-4 rounded-2xl font-black">店舗を開設</button>
          </form>
        </section>

        <section className="bg-white rounded-[2rem] p-8 shadow-sm border border-slate-100 overflow-x-auto">
          <h2 className="text-xl font-black mb-6">🔑 配信権限（1km圏内のみ有効）</h2>
          <table className="w-full text-left">
            <thead>
              <tr className="border-b border-slate-50">
                <th className="py-4 px-4 text-[10px] font-black text-slate-400 uppercase">店舗</th>
                {allProperties.map(prop => (
                  <th key={prop.uuid} className="py-4 px-4 text-[10px] font-black text-slate-400 text-center">{prop.name}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {stores.map(store => (
                <tr key={store.id} className="border-b border-slate-50">
                  <td className="py-4 px-4 font-bold text-sm">{store.name}</td>
                  {allProperties.map(prop => {
                    const isGranted = store.store_property_permissions?.some((p: any) => p.property_id === prop.uuid);
                    const inRange = isWithinRange(store, prop);
                    return (
                      <td key={prop.uuid} className="py-4 px-4 text-center">
                        {inRange ? (
                          <input type="checkbox" checked={!!isGranted} onChange={() => togglePermission(store.id, prop.uuid, !!isGranted)} className="w-5 h-5 rounded" />
                        ) : (
                          <span className="text-[10px] text-slate-300 font-bold italic">Distance Out</span>
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      </div>
    </AdminLayout>
  );
}